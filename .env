# ==== JWT ====
ACCESS_TOKEN_LIFETIME_MIN=60
REFRESH_TOKEN_LIFETIME_DAYS=1

# ==== Django ====
SECRET_KEY=super-secret-change-me

# локалка: оставь True, так проще диагностировать
DEBUG=True

# Разрешаем все типичные локальные хосты
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],0.0.0.0

# Разрешаем фронтовые источники (Origin). Указываются ПОЛНЫЕ origin'ы, с портом.
# Если используешь Vite dev-server: http://localhost:5173
# Если фронт отдает nginx на корне, то достаточно http://localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# Если фронт шлет куки/Авторизацию, включи:
CORS_ALLOW_CREDENTIALS=true

# Доверенные источники для CSRF (должны совпадать с тем, откуда открываешь сайт)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173

# ==== БД ====
DATABASE_URL=sqlite:///db.sqlite3
