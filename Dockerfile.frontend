# ---------- build ----------
FROM node:20-alpine AS build
WORKDIR /app

# зависимости — отдельный слой
COPY frontend/package*.json ./
RUN npm ci

# исходники фронта и сборка
COPY frontend/ ./
RUN npm run build

# ---------- runtime ----------
FROM nginx:1.27-alpine

# собранный фронт — в стандартную директорию nginx
COPY --from=build /app/dist /usr/share/nginx/html

# КЛАДЁМ ИМЕННО server-конфиг в conf.d (а не nginx.conf!)
COPY etc/nginx/conf.d/default.conf /etc/nginx/conf.d/default.conf

# (не обязательно, но понятно, какой порт слушает контейнер)
EXPOSE 80
